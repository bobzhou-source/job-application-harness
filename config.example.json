{
  "browser": {
    "executable": "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
    "profileDir": "~/.job-app-chrome",
    "debugHost": "127.0.0.1",
    "debugPort": 0,
    "maxTabs": 4
  },
  "resumes": {
    "directory": "~/Documents/resumes",
    "filePattern": "resume_{lane}.pdf",
    "fallbackLane": "general",
    "factsFile": "MASTER-FACTS.md",
    "latexPreamble": "_preamble.tex"
  },
  "documents": {
    "transcript": ""
  },
  "discovery": {
    "handshakeBaseUrl": "https://your-school.joinhandshake.com",
    "queries": ["software engineer intern"],
    "includeTitlePattern": "software|developer|data",
    "excludeTitlePattern": "full[- ]time|senior|manager",
    "lanes": [
      { "name": "general", "titlePattern": ".*" }
    ],
    "specialLane": {
      "name": "general",
      "employerPattern": "(?!)"
    },
    "season": {
      "primaryStartMonths": ["May", "Jun", "Jul"],
      "shortTermStartMonth": "Jan",
      "shortTermEndMonths": ["Jan", "Feb"]
    },
    "sources": ["handshake", "levelsfyi", "quantlists"],
    "minHourly": 0,
    "fx": { "GBP": 1.33, "EUR": 1.16, "CAD": 0.72 },
    "lists": [
      "https://raw.githubusercontent.com/vanshb03/Summer2027-Internships/dev/README.md",
      "https://raw.githubusercontent.com/speedyapply/2027-SWE-College-Jobs/main/README.md",
      "https://raw.githubusercontent.com/Chieler/Summer-2027-SWE-Internships/main/README.md",
      "https://raw.githubusercontent.com/sndsh404/summer-2027-internships/main/README.md",
      "https://zshah101.github.io/Automated-List-Of-Summer-2027-and-Fall-2026-Tech-Internships/api/jobs.json",
      "https://raw.githubusercontent.com/aprameyak/2027-tech-jobs/main/listings.json"
    ],
    "boards": { "greenhouse": [], "lever": [], "ashby": [] },
    "linkedin": { "queries": ["software engineer intern summer 2027"], "locations": ["United States"], "pages": 2 },
    "freehire": { "queries": ["software engineer intern 2027"], "postedWithinDays": 90, "pages": 2 },
    "listings": {
      "url": "https://raw.githubusercontent.com/SimplifyJobs/Summer2027-Internships/dev/.github/scripts/listings.json",
      "terms": ["Summer 2027"],
      "locationPattern": ",\\s*(AL|AK|AZ|AR|CA|CO|CT|DE|DC|FL|GA|HI|ID|IL|IN|IA|KS|KY|LA|ME|MD|MA|MI|MN|MS|MO|MT|NE|NV|NH|NJ|NM|NY|NC|ND|OH|OK|OR|PA|RI|SC|SD|TN|TX|UT|VT|VA|WA|WV|WI|WY|PR)$|\\b(USA|United States)\\b|^Remote( in US| - US)?$"
    }
  },
  "models": {
    "driver": {
      "backend": "openrouter-decisions",
      "model": "typesafe/jev-1.13",
      "endpoint": "https://openrouter.ai/api/alpha/decisions",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "planner": {
      "backend": "openai-compatible",
      "model": "deepseek-v4-flash",
      "endpoint": "https://api.deepseek.com/chat/completions",
      "apiKeyEnv": "DEEPSEEK_API_KEY"
    },
    "fallback": {
      "backend": "openrouter",
      "model": "anthropic/claude-haiku-4-5",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    },
    "writer": {
      "backend": "openrouter",
      "model": "anthropic/claude-sonnet-5-5",
      "endpoint": "https://openrouter.ai/api/v1/chat/completions",
      "apiKeyEnv": "OPENROUTER_API_KEY"
    }
  },
  "applicant": {
    "displayName": "Alex Example",
    "coverLetterHeading": "",
    "relocateAnywhere": false,
    "workInPerson": false,
    "summerAvailability": "",
    "dateOfBirth": "",
    "workAuthorizedCountries": ["United States"]
  },
  "email": {
    "enabled": false,
    "accountLabel": "",
    "mcpServer": "~/.local/share/multi-gmail-mcp/gmail-mcp.js",
    "tokenDatabase": "~/.gmail-mcp-tokens.db",
    "oauthCredentials": "~/.gmail-mcp-oauth.json"
  },
  "credentials": {
    "backend": "macos-keychain",
    "servicePrefix": "job-app:"
  },
  "notifications": {
    "backend": "console",
    "title": "Job harness",
    "sound": "Glass"
  },
  "queue": {
    "runTimeoutSeconds": 900
  },
  "runtime": {
    "debug": false
  },
  "outreach": {
    "gmail": {
      "clientModule": "~/path/to/multi-gmail-mcp/local/src/gmail-client.js",
      "account": "you@example.edu"
    },
    "calendar": {
      "bridgeApp": "~/path/to/CalendarBridge.app",
      "calendarId": "CALENDAR-UUID",
      "alarmMinutes": 10
    },
    "profileQueries": [
      {
        "id": "example-topic",
        "label": "Example research topic",
        "query": "one sentence describing work you have done and want to do, in paper-abstract language",
        "terms": "short keyword search phrase",
        "resumeLane": "swe"
      }
    ],
    "draft": {
      "signoff": "Best,\nYour Name\nYour College",
      "ask": "a 15-minute call about a research position, in person for Jan Plan 2027 or Summer 2027",
      "fundingLine": "",
      "minWords": 120,
      "maxWords": 180
    },
    "openalex": {
      "mailto": "you@example.edu",
      "lookbackYears": 3,
      "perTopic": 100
    },
    "ranking": {
      "n": 10,
      "minWorks": 2,
      "topK": 3,
      "recencyHalfLifeYears": 1.5,
      "piBonus": 0.25
    },
    "scheduling": {
      "days": [
        "Tue",
        "Wed",
        "Thu"
      ],
      "window": [
        "09:00",
        "10:30"
      ],
      "perDay": 3,
      "gapMinutes": 15
    },
    "decisionThreshold": 0.6,
    "exclusionDirs": []
  }
}
